# Server:
PORT='3000'
NODE_ENV='development'
NEXT_PUBLIC_APP_URL='http://localhost:3000'
MONGODB_URI='mongodb://localhost:27017/fridge-magnets'

# Rate Limiting:
# Magnet movement rate limiting (per client)
# Default: 90 moves per second (more generous than 60fps to account for lag spikes)
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_MOVES=90

# Chat rate limiting (per client)
# Default: 15 messages per 10 seconds (1.5/sec average - very generous for chat)
CHAT_RATE_LIMIT_WINDOW_MS=10000
CHAT_RATE_LIMIT_MAX_MESSAGES=15

# API rate limiting (per IP) - for contact form submissions
# Default: 5 requests per 15 minutes
API_RATE_LIMIT_MAX_REQUESTS=5
API_RATE_LIMIT_WINDOW_MS=900000

# Resend:
RESEND_API_KEY='...'
RESEND_FROM_EMAIL='admin@mail.fridgemagnets.fun'
RESEND_TO_EMAIL='email@yourdomain.dev'

# Turnstile:
NEXT_PUBLIC_TURNSTILE_SITE_KEY='...'
TURNSTILE_SECRET_KEY='...'

# Admin - Dollar signs from bcrypt frequently need to be escaped here:
# Generate a hash with: bcrypt.hash("password", 10);
ADMIN_PASSWORD_HASH='...'

# Socket load tests:
TEST_CONCURRENT_USERS="100"
TEST_DURATION_MS="30000"
TEST_MAGNET_COUNT="0" # 0 = auto-detect from welcome event
# Activity mode: "full" or "realistic"
TEST_ACTIVITY_MODE=realistic
# Milliseconds between moves (default: 17ms for full, 500ms for realistic)
TEST_MOVE_INTERVAL_MS=500
# Probability a user is dragging (0-1, realistic mode only, default: 0.3)
# (0.2 = 20% of users actively dragging at any time)
TEST_DRAG_PROBABILITY=0.5
# Drag session duration range (realistic mode - default min: 2000, default max: 8000)
TEST_DRAG_SESSION_MIN_MS=2000 
TEST_DRAG_SESSION_MAX_MS=10000
# Enable latency measurement
TEST_MEASURE_LATENCY=true
# Latency simulation: "none", "slow-3g", "fast-3g", "4g", "custom"
TEST_NETWORK_PROFILE="4g"
# Custom latency in milliseconds (for custom profile)
TEST_NETWORK_LATENCY_MS=0
# Random jitter added to latency (for custom profile)
TEST_NETWORK_JITTER_MS=0